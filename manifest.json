{
  "manifest_version": 3,
  "name": "Bilibili Single Tab",
  "version": "2.4.0",
  "description": "视频在唯一标签中播放；视频页内跳别的视频可一键返回上个视频；点 logo 切回来源标签。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*", "*://b23.tv/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.bilibili.com/*", "*://b23.tv/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
